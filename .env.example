# Copia este archivo como .env para desarrollo local. El .env real NUNCA se sube.
#
# En Render no hace falta rellenar esto a mano: render.yaml declara las variables.
# SECRET_KEY la genera Render sola; ADMIN_USER y ADMIN_PASSWORD_HASH se escriben
# en el panel (Environment) porque no deben viajar en el repositorio.

FLASK_ENV=development

# Genera uno con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# En local, SQLite. En produccion Render inyecta un Postgres (postgres://...),
# que la app normaliza sola a postgresql+psycopg://
DATABASE_URL=sqlite:///life.db

# Acceso al panel de leads (/panel). Genera el hash con:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('TU_CONTRASENA'))"
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Almacen del limitador de peticiones. memory:// sirve con una sola instancia.
RATELIMIT_STORAGE_URI=memory://

# En local ponlo en false: sin HTTPS, las cookies seguras no se guardarian.
FORCE_HTTPS=false

# --- Aviso por correo cuando entra un lead ---
# Con Gmail hay que usar una "contraseña de aplicación" (16 letras), NO la
# contraseña normal de la cuenta. Se genera en:
#   Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones
# Si dejas SMTP_USER o SMTP_PASSWORD vacíos, el sitio funciona igual pero no avisa.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=agenciainam00@gmail.com
SMTP_PASSWORD=
NOTIFICAR_A=agenciainam00@gmail.com

# Se usa en el pie del correo, para ir al panel de un clic.
URL_PANEL=https://tu-sitio.onrender.com/panel
