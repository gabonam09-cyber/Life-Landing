# entorno virtual (aqui es un enlace simbolico a una ruta local)
.venv/
.venv

# secretos y base de datos con leads: nunca deben subir.
# El comodin cubre respaldos y variantes (.env.respaldo, .env.local, .env.viejo...),
# que llevan los mismos secretos dentro. .env.example si sube: no tiene valores.
.env
.env.*
!.env.example
instance/

# python
__pycache__/
*.pyc

# macOS
.DS_Store
